---
import { Picture } from "astro:assets";
import backgroundLow from "../assets/background-low.webp";
import backgroundHigh from "../assets/background.webp";

// Get the URL string for the low-res background
const backgroundLowSrc = backgroundLow.src;
---

<script define:vars={{ backgroundLowSrc }}>
  document.addEventListener('alpine:init', () => {
    Alpine.data('backgroundImageData', () => ({
      loaded: false,
      blurSrc: '',
      defaultLowResSrc: backgroundLowSrc,
      init() {
        if (this.$store.image.isCustomBackgroundSet) {
          this.$store.image.getBlurredImageUrl().then(url => {
            if (url) {
              this.blurSrc = url;
            }
          });
        }
      }
    }));
  });
</script>

<div
  class="z-0 absolute inset-0 overflow-hidden"
  x-data="backgroundImageData"
  :style="blurSrc ? `background-image: url('${blurSrc}'); background-size: cover; background-position: center;` : `background-image: url('${defaultLowResSrc}'); background-size: cover; background-position: center;`"
>
  <Picture
    src={backgroundHigh}
    formats={["avif", "webp"]}
    alt="backgroundHigh"
    class="object-cover w-full h-full absolute inset-0 transition-opacity duration-1000"
    id="default-background"
    x-init="if ($el.complete) { loaded = true; }"
    x-show="!$store.image.isCustomBackgroundSet"
    @load="loaded = true"
    :class="{ 'opacity-100': loaded, 'opacity-0': !loaded }"
  />
  <img
    src=""
    alt="Custom background"
    class="object-cover w-full h-full absolute inset-0 transition-opacity duration-1000 opacity-0"
    x-init="$store.image.loadCustomBackgroundImage(); if ($el.complete) { loaded = true; }"
    x-show="$store.image.isCustomBackgroundSet"
    @load="loaded = true"
    id="custom-background"
  />
</div>
