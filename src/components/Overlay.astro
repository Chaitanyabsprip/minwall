---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import OverlayItem from "./OverlayItem.astro";

const websites = await getCollection("websites");
---

<div
  class="inset-0 w-screen h-screen
    backdrop-blur-xl bg-gray-500/10
    pt-8 pb-28 overflow-hidden
    absolute z-1"
  x-show="$store.overlay.show"
  x-transition:enter="transition ease-out duration-300 backdrop-blur-3xl"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="transition ease-out duration-300 backdrop-blur-3xl"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
>
  <div class="w-full flex justify-center m-4">
    <input
      id="overlay-search"
      x-ref="overlay-search"
      type="text"
      placeholder="Search..."
      class="px-4 py-2 mb-2
      rounded-2xl bg-gray-950/50 text-gray-500
      focus:outline-none focus:ring-2 focus:ring-gray-800
      w-1/4 min-w-[240px]"
      autocomplete="off"
      @input="$store.overlay.search($event.target.value)"
      @keydown.enter="followMatchedLink()"
      @blur="setTimeout(() => {$store.overlay.show = false}, 50)"
    />
  </div>
  <div
    x-init="$store.overlay.findItems($el)"
    class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-8 items-start
    mx-auto w-full h-full max-h-[calc(100vh-17rem)] lg:max-h-[calc(100vh-14rem)]
    overflow-auto px-12 sm:px-32 lg:px-56
     scrollbar-thin scrollbar-thumb-gray-900 scrollbar-thumb-rounded-full"
  >
    {
      websites.map((website) => (
        <OverlayItem
          label={website.data.label}
          url={website.data.url}
          id={website.data.id}
        >
          <Icon name={website.data.id} class="w-12 h-12 sm:w-16 sm:h-16" />
        </OverlayItem>
      ))
    }
  </div>

  <div class="absolute bottom-4 right-4 flex gap-3 opacity-10">
    <button
      class="bg-gray-800/95 hover:bg-gray-700/95 text-white rounded-full p-3 backdrop-blur-md transition-colors"
      aria-label="Reset to default background"
      title="Reset to default background"
      @click="$store.image.resetBackground()"
      x-show="$store.image.isCustomBackgroundSet"
    >
      <Icon name="reload" class="w-4 h-4" />
    </button>

    <button
      class="bg-gray-800/95 hover:bg-gray-700/95 text-white rounded-full p-3 backdrop-blur-md transition-colors"
      @click="$refs.fileInput.click()"
      aria-label="Upload background image"
      title="Upload custom background"
    >
      <Icon name="upload" class="w-4 h-4" />
    </button>
    <input
      type="file"
      accept="image/*"
      class="hidden"
      id="background-image-upload"
      @change="$store.image.onImageUpload($event)"
      x-ref="fileInput"
    />
  </div>
</div>
